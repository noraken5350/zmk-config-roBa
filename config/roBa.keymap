#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 TAB>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp MINUS>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                   &kp T                                                                                        &kp Y                   &kp U  &lt 5 I    &kp O    &lt 5 P
&kp A             &kp S         &kp D         &kp F                   &kp G                   &kp LS(LG(S))                      &kp MINUS                         &kp H                   &kp J  &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                   &kp B                   &lt_to_layer_0 6 INT_MUHENKAN      &lt_to_layer_0 3 INTERNATIONAL_4  &kp N                   &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 1 LC(Z)  &lt_to_layer_0 2 SPACE  &lt_to_layer_0 3 ENTER             &lt_to_layer_0 1 BACKSPACE        &lt_to_layer_0 2 ENTER                             &mt RIGHT_CONTROL ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PG_UP>;
        };

        kigou {
            bindings = <
&trans            &kp SQT          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                                                &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp AMPERSAND  &kp SEMICOLON  &kp MINUS
&trans            &kp DOLLAR       &kp PERCENT           &kp AMPERSAND          &trans     &trans                &trans               &trans            &kp EXCLAMATION    &kp QUESTION   &kp COLON      &kp TILDE
&kp LEFT_SHIFT    &kp EXCLAMATION  &kp DOUBLE_QUOTES     &kp HASH               &kp EQUAL  &kp INT_MUHENKAN      &kp INTERNATIONAL_4  &trans            &kp COMMA          &kp COMMA      &kp PERIOD     &kp AT_SIGN
&kp LEFT_CONTROL  &kp LEFT_GUI     &kp UNDERSCORE        &trans                 &kp SPACE  &kp ENTER             &kp BACKSPACE        &kp ENTER                                                          &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        NUM {
            bindings = <
&kp SLASH              &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PG_UP                                                        &kp CARET         &kp F7  &kp F8  &kp F9  &kp F12
&kp ASTERISK           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PAGE_DOWN  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE       &kp EXCLAMATION   &kp F4  &kp F5  &kp F6  &kp F11
&mt LEFT_SHIFT MINUS   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp EQUAL      &kp INT_MUHENKAN             &kp INTERNATIONAL_4  &kp LEFT_BRACKET  &kp F1  &kp F2  &kp F3  &kp F10
&mt LEFT_CONTROL PLUS  &kp PERIOD       &kp KP_NUMBER_0  &trans           &kp SPACE      &kp ENTER                    &kp BACKSPACE        &kp ENTER                                 &kp ESCAPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE         &kp LG(D)               &kp LG(UP_ARROW)    &kp LG(E)                &kp PG_UP                                                 &trans     &kp LS(TAB)     &kp UP_ARROW   &kp TAB          &trans
&kp TAB            &kp LG(LEFT_ARROW)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &kp PAGE_DOWN  &trans                &trans               &kp HOME   &kp LEFT_ARROW  &kp DOWN       &kp RIGHT_ARROW  &kp END
&kp LEFT_SHIFT     &kp LG(LS(LEFT_ARROW))  &trans              &kp LG(LS(RIGHT_ARROW))  &trans         &kp INT_MUHENKAN      &kp INTERNATIONAL_4  &kp LC(Z)  &kp LS(SPACE)   &kp LC(SPACE)  &kp LC(A)        &trans
&kp RIGHT_CONTROL  &trans                  &trans              &trans                   &kp SPACE      &kp ENTER             &kp BACKSPACE        &kp ENTER                                                  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
