#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
        };

        atto {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <32 33>;
        };

        hennkann {
            bindings = <&kp INTERNATIONAL_4>;
            key-positions = <28 29>;
        };

        mb1 {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };

        BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 17>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <8 9>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt_to_layer_0 5 Q  &kp W         &kp E         &kp R                       &kp T                                                                                 &kp Y                   &kp U  &lt 5 I    &kp O    &lt 5 P
&mt LEFT_SHIFT A    &kp S         &kp D         &kp F                       &kp G                   &kp LS(LG(S))                    &kp SQT                      &kp H                   &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z    &kp X         &kp C         &kp V                       &kp B                   &lt_to_layer_0 6 LANG_HANJA      &lt_to_layer_0 1 LANGUAGE_1  &kp N                   &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL           &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 1 BACKSPACE  &lt_to_layer_0 2 SPACE  &lt_to_layer_0 3 ENTER           &lt_to_layer_0 2 BACKSPACE   &lt_to_layer_0 3 ENTER                             &mt RIGHT_CONTROL ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        kigou {
            bindings = <
&trans            &kp LS(N7)       &kp ASTRK       &kp LS(N9)        &trans                                            &kp ASTRK         &kp LS(N9)       &kp AMPERSAND  &kp SEMICOLON  &kp MINUS
&trans            &kp DOLLAR       &kp PERCENT     &kp LS(NUMBER_6)  &kp CARET      &trans              &trans         &kp LEFT_BRACKET  &kp EXCLAMATION  &kp QUESTION   &kp SQT        &kp LS(EQUAL)
&kp LEFT_SHIFT    &kp EXCLAMATION  &kp AT          &kp HASH          &kp LS(MINUS)  &kp LANGUAGE_2      &kp LANG1      &kp INT_YEN       &kp PLUS         &kp COMMA      &kp PERIOD     &mt LSHFT LS(INT_RO)
&kp LEFT_CONTROL  &kp LEFT_GUI     &kp LS(INT_RO)  &trans            &kp SPACE      &kp ENTER           &kp BACKSPACE  &kp ENTER                                                        &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        NUM {
            bindings = <
&kp KP_DIVIDE             &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PG_UP                                                  &kp LC(LS(SEMICOLON))  &kp LC(S)  &kp UP_ARROW   &trans           &kp LC(MINUS)
&kp KP_MULTIPLY           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PAGE_DOWN  &kp LC(LA(KP_NUMBER_0))      &kp PG_UP      &kp HOME               &kp LEFT   &kp DOWN       &kp RIGHT_ARROW  &kp END
&mt LEFT_SHIFT KP_MINUS   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LS(MINUS)  &kp LANG2                    &kp PAGE_DOWN  &trans                 &trans     &kp LC(SPACE)  &kp LS(SPACE)    &kp RIGHT_SHIFT
&mt LEFT_CONTROL KP_PLUS  &kp PERIOD       &kp KP_NUMBER_0  &trans           &kp SPACE      &kp ENTER                    &kp BACKSPACE  &kp ENTER                                                         &kp ESCAPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE         &kp F7        &kp F8        &kp F9  &kp F12                                   &trans     &kp LC(S)       &kp UP_ARROW   &kp LC(RS(SEMICOLON))  &kp LC(MINUS)
&kp LEFT_SHIFT     &kp F4        &kp F5        &kp F6  &kp F11    &kp LS(F3)      &kp PG_UP      &kp HOME   &kp LEFT_ARROW  &kp DOWN       &kp RIGHT_ARROW        &kp END
&kp LEFT_SHIFT     &kp F1        &kp F2        &kp F3  &kp F10    &kp LANG2       &kp PAGE_DOWN  &trans     &trans          &kp LC(SPACE)  &kp LS(SPACE)          &mt RIGHT_SHIFT LC(END)
&kp RIGHT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &trans  &kp SPACE  &kp ENTER       &kp BACKSPACE  &kp ENTER                                                        &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_DOWN) LC(PG_UP)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans            &kp LC(LG(D))   &trans                   &trans                             &trans  &kp LG(TAB)   &kp LG(UP_ARROW)  &kp LG(E)            &trans
&trans  &kp LC(LG(LEFT))  &kp LC(LG(F4))  &kp LG(LC(RIGHT_ARROW))  &trans  &trans      &kp LC(PG_UP)  &trans  &kp LG(LEFT)  &kp LG(DOWN)      &kp LG(RIGHT_ARROW)  &trans
&trans  &trans            &trans          &trans                   &trans  &trans      &kp LC(PG_DN)  &trans  &trans        &trans            &trans               &trans
&trans  &trans            &trans          &trans                   &trans  &trans      &trans         &trans                                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans     &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(X)  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
